---
# Basis-Stil (Google ist gut für C/C++)
BasedOnStyle: Google

# --- WICHTIGE ANPASSUNGEN ---

# Einrückung: 4 Leerzeichen (Standard in den meisten Projekten)
IndentWidth: 4
TabWidth: 4

# Keine Tabs, nur Leerzeichen
UseTab: Never

# Maximale Zeilenlänge (verhindert extrem breiten Code)
ColumnLimit: 100

# Wählt deinen Stil (Attach = kompakt, Allman = luftig)
# Ändere das hier auf 'Allman', wenn du die Klammern in neuer Zeile willst
BreakBeforeBraces: Attach

# Zeiger-Sternchen beim Typ (int* ptr) oder Variable (int *ptr)?
# Right bedeutet: int *ptr (üblich in Embedded C)
PointerAlignment: Right

# Sortiert deine #include Befehle alphabetisch
SortIncludes: true

# Fügt Leerzeichen bei Operatoren ein (x = a + b statt x=a+b)
SpaceBeforeAssignmentOperators: true

# Richtet switch-case sauber ein
IndentCaseLabels: true